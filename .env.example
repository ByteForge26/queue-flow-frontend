# Tracked example/template only: copy this file to .env.local for local work
# and fill in your own values. Keep real values out of this file.
# .env.local is git-ignored and is for local development only.
# For Netlify, import the filled .env.local values in the site's Environment
# variables settings; Netlify does not read this local file during deploy.
#
# Vite sirf "VITE_" prefix wale env vars ko frontend code mein expose karta
# hai (import.meta.env.VITE_API_URL) - security ke liye, taaki galti se
# server-only secrets browser bundle mein leak na ho jayen.
#
# Local dev: ye file use nahi hoti, VITE_API_URL unset chhod do -> Vite ka
#   dev proxy ("/api", "/ws" -> localhost:8081, dekh vite.config.ts) kaam
#   karta hai jaise pehle.
#
# Production (Netlify): frontend aur backend alag domains pe hain; backend
# API URL trailing slash ke bina hona chahiye.
VITE_API_URL=https://queueflow-backend-kpgx.onrender.com

# Firebase Console > Project settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console > Project settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=