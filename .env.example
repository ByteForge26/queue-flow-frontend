# Vite sirf "VITE_" prefix wale env vars ko frontend code mein expose karta
# hai (import.meta.env.VITE_API_URL) - security ke liye, taaki galti se
# server-only secrets browser bundle mein leak na ho jayen.
#
# Local dev: ye file use nahi hoti, VITE_API_URL unset chhod do -> Vite ka
#   dev proxy ("/api", "/ws" -> localhost:8081, dekh vite.config.ts) kaam
#   karta hai jaise pehle.
#
# Production (Vercel): frontend aur backend alag domains pe deployed hain,
#   isliye Vercel project settings mein VITE_API_URL set karna PADEGA -
#   apna Render backend ka URL (trailing slash ke bina):
VITE_API_URL=https://queueflow-backend.onrender.com